generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Status {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id          String     @id @default(cuid())

  name        String
  email       String     @unique
  password    String

  role        Role       @default(MEMBER)

  // Relations
  assignedTasks Task[]

  projects    Project[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Project {
  id           String     @id @default(cuid())

  title        String
  description  String?

  // Admin who created project
  createdBy    String
  creator      User       @relation(fields: [createdBy], references: [id])

  // Relations
  tasks        Task[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Task {
  id             String      @id @default(cuid())

  title          String
  description    String?

  // Task Priority
  priority       Priority    @default(MEDIUM)

  // Task Status
  status         Status      @default(TODO)

  // Time Tracking
  estimatedTime  Int?        // in minutes

  startedAt      DateTime?
  completedAt    DateTime?

  dueDate        DateTime?

  // Assigned Member
  assignedTo     String
  assignee       User        @relation(fields: [assignedTo], references: [id])

  // Project Relation
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])

  isPrivate      Boolean     @default(false)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}